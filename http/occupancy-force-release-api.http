@baseUrl = http://localhost:8084

### 점유 강제 종료 API (MR-21)
### 점유자 기수의 매니저가 점유를 강제 종료한다. 반납(/release)과 달리 공실 알림을
### 발송하지 않고 대기 신청을 물리 삭제한다 — RoomOccupancyLifecycleService.forceRelease 참고.
### occupancy-api.http(cohortId=1, spaceId=1~5), vacancy-alert-api.http(cohortId=2,
### spaceId=10/11)와 겹치지 않도록 cohortId=3/4, spaceId=20/21을 쓴다.

### =========================================================
### 사전 준비 (psql로 직접 INSERT)
###
### -- 기수 A(3): 점유자·담당 매니저·일반 학생·공실 알림 대기자가 소속된 기수.
### -- 기수 B(4): "담당하지 않는 기수의 매니저" 403 케이스(명세 04 §5)를 재현하기 위한
### -- 무관한 기수 — otherManager는 기수 A와 아무 관계가 없다.
### INSERT INTO learning_service.cohorts
###   (id, name, start_date, end_date, status, created_by_user_id)
### VALUES
###   (3, '강제 종료 테스트 기수 A', '2026-01-01', '2026-12-31', 'ACTIVE', gen_random_uuid()),
###   (4, '강제 종료 테스트 기수 B', '2026-01-01', '2026-12-31', 'ACTIVE', gen_random_uuid());
###
### INSERT INTO learning_service.cohort_memberships
###   (cohort_id, user_id, role, status, processed_at, processed_by_user_id)
### VALUES
###   (3, '40404040-4040-4040-4040-404040404040', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (3, '50505050-5050-5050-5050-505050505051', 'MANAGER', 'ACTIVE', now(), gen_random_uuid()),
###   (3, '60606060-6060-6060-6060-606060606060', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (3, '80808080-8080-8080-8080-808080808080', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (4, '70707070-7070-7070-7070-707070707070', 'MANAGER', 'ACTIVE', now(), gen_random_uuid());
###
### -- occupier가 방을 점유하려면 재실이 필요하다. 기수 B는 아무도 체크인하지 않으므로
### -- 출결 정책이 필요 없다.
### INSERT INTO learning_service.cohort_attendance_policies
###   (cohort_id, timezone, scheduled_start_time, scheduled_end_time, updated_by_user_id)
### VALUES
###   (3, 'Asia/Seoul', '09:00', '18:00', gen_random_uuid());
###
### -- spaceId=20: occupier가 점유해 강제 종료 대상이 될 회의실
### -- spaceId=21: 아무도 점유하지 않는 채로 남겨 "활성 점유 없음(409)" 케이스에 쓴다
### INSERT INTO learning_service.spaces
###   (id, name, space_type, capacity, status)
### VALUES
###   (20, '강제 종료 테스트 회의실 A', 'MEETING', 4, 'ACTIVE'),
###   (21, '강제 종료 테스트 회의실 B(항상 빈 방)', 'MEETING', 4, 'ACTIVE');
###
### SELECT setval(
###   pg_get_serial_sequence('learning_service.cohorts', 'id'),
###   (SELECT MAX(id) FROM learning_service.cohorts));
###
### SELECT setval(
###   pg_get_serial_sequence('learning_service.spaces', 'id'),
###   (SELECT MAX(id) FROM learning_service.spaces));
###
### 확인:
### SELECT id, cohort_id, user_id, role, status FROM learning_service.cohort_memberships
###  WHERE cohort_id IN (3, 4) ORDER BY id;
### SELECT id, name, status FROM learning_service.spaces WHERE id IN (20, 21) ORDER BY id;
###
### 주의: 순서 의존이다. 1번부터 차례로 실행할 것.
### 토큰은 로컬 secrets/jwt-private.pem으로 서명했고 secrets/jwt-public.pem으로 검증되니
### .env.local에 JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem이 설정돼 있어야 통과한다.
### exp가 지나면(발급 후 24시간) 401 AUTH_AUTHENTICATION_REQUIRED로 바뀌니 새로 발급해야 한다:
###   scripts/issue-test-jwt.sh --sub {{occupier}}  (manager·student·otherManager·waiter도 같은 방식)
### =========================================================

