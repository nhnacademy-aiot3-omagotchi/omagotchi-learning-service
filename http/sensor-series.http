# 공간 센서 시계열 조회 API 확인.
# 앱을 local 프로파일로 띄우고 위에서 아래로 실행합니다.
#
# 이 엔드포인트는 센서 Feature에서 유일하게 기수 소속이면 되는 경로입니다.
# 매니저가 아니어도 되지만, 해당 기수의 ACTIVE 소속 JWT는 필요합니다.
#
# 주의 1. 센서 수집이 멈춰 있으면 points가 비어 있을 수 있습니다. 오류가 아닙니다.
# 주의 2. accessToken 에 실제 토큰을 넣은 채로 커밋하지 않습니다.

@baseUrl = http://localhost:8084
@accessToken = <기수 소속 JWT>
@cohortId = 1
@measurement = temperature
@location = 실습실


### 인증 없이 호출하면 401
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/sensors/space-series?location={{location}}&measurement={{measurement}}&window=WEEK
Accept: application/json

> {%
    client.test("인증 필요", function () {
        client.assert(response.status === 401, "HTTP 상태가 401이어야 합니다.");
        client.assert(response.body.code === "AUTH_AUTHENTICATION_REQUIRED", "인증 오류 코드여야 합니다.");
    });
%}


### 없는 기간 값이면 400
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/sensors/space-series?location={{location}}&measurement={{measurement}}&window=YEAR
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("잘못된 window", function () {
        client.assert(response.status === 400, "HTTP 상태가 400이어야 합니다.");
        client.assert(response.body.code === "COMMON_INVALID_REQUEST", "요청값 오류 코드여야 합니다.");
    });
%}


### 소문자 window도 허용
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/sensors/space-series?location={{location}}&measurement={{measurement}}&window=week
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("대소문자 무관", function () {
        client.assert(response.status === 200, "HTTP 상태가 200이어야 합니다.");
        client.assert(response.body.window === "WEEK", "WEEK으로 해석되어야 합니다.");
    });
%}


### 소속이 아닌 기수를 물으면 404 — 기수 존재 자체를 숨긴다
GET {{baseUrl}}/api/v1/cohorts/9999/sensors/space-series?location={{location}}&measurement={{measurement}}&window=WEEK
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("남의 기수", function () {
        client.assert(response.status === 404, "HTTP 상태가 404여야 합니다.");
        client.assert(response.body.code === "COHORT_NOT_FOUND", "기수 없음 코드여야 합니다.");
    });
%}


### 공간 집계 — 비활성 기기가 빠지고 표시명이 채워진다
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/sensors/space-series?location={{location}}&measurement={{measurement}}&window=WEEK
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("공간 집계 계약", function () {
        client.assert(response.status === 200, "HTTP 상태가 200이어야 합니다.");
        client.assert(response.body.interval === "1h", "간격은 1h여야 합니다.");
        client.assert(response.body.sensorCount === response.body.sensors.length,
            "sensorCount와 명단 길이가 같아야 합니다.");
    });

    client.test("비활성 기기는 집계에서 빠진다", function () {
        var points = response.body.sensors.map(function (s) { return s.point; });
        client.assert(points.indexOf("복도") === -1, "복도 센서는 active=false 라 포함되면 안 됩니다.");
    });

    client.test("등록된 기기는 표시명이 채워진다", function () {
        response.body.sensors.forEach(function (s) {
            client.assert(s.displayName !== null, "표시명이 비어 있습니다: " + s.deviceEui);
        });
    });

    client.test("집계 값의 관계가 맞다", function () {
        var sensorCount = response.body.sensorCount;
        response.body.points.forEach(function (p) {
            if (p.count === 0) {
                client.assert(p.avg === null, "수집이 없으면 avg가 null이어야 합니다: " + p.time);
                return;
            }
            client.assert(p.min <= p.avg && p.avg <= p.max,
                "최소 <= 평균 <= 최대가 아닙니다: " + p.time);
            client.assert(p.count <= sensorCount,
                "count가 센서 수를 넘습니다: " + p.time);
        });
    });
%}


### 없는 공간이면 오류가 아니라 빈 결과
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/sensors/space-series?location=없는공간&measurement={{measurement}}&window=WEEK
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("없는 공간", function () {
        client.assert(response.status === 200, "오류가 아니라 빈 결과여야 합니다.");
        client.assert(response.body.sensorCount === 0, "센서가 없어야 합니다.");
    });
%}
