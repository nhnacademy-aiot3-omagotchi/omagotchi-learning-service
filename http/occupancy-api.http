@baseUrl = http://localhost:8084

### 회의실 점유 API (MR-01)
### 요청 본문 없음 — 점유자 멤버십은 재실 구간에서 도출한다 (명세서 02).
### 요청자는 Access JWT의 sub에서만 읽는다 (RoomOccupancyController, OccupancyParticipantController 참고).
### 재실 판정은 실제 출결 데이터를 본다 (AttendancePresenceQueryService·PresenceIntervalRepository) —
### cohort_memberships만으로는 재실이 되지 않는다. presence_intervals가 ended_at IS NULL이고
### state <> 'AWAY'인 열린 구간이 있어야 재실이며, 그 구간은 출석 체크인(POST
### /api/v1/cohorts/{cohort-id}/attendance-records/check-in)이 만든다 — 아래 "사전 준비" 참고.
### 응답 필드: occupancyId, spaceId, status, startedAt, expiresAt, extensionCount, remainingSeconds

### =========================================================
### 사전 준비 (psql로 직접 INSERT)
###
### -- 기수·멤버십. 재실은 이것만으로는 안 되고, 아래 출결 정책 INSERT +
### -- 체크인 API 호출(파일 하단 "[사전 준비] 재실 체크인" 참고)까지 해야 성립한다.
### INSERT INTO learning_service.cohorts
###   (id, name, start_date, end_date, status, created_by_user_id)
### VALUES
###   (1, '점유 테스트 기수', '2026-01-01', '2026-12-31', 'ACTIVE', gen_random_uuid());
###
### INSERT INTO learning_service.cohort_memberships
###   (cohort_id, user_id, role, status, processed_at, processed_by_user_id)
### VALUES
###   (1, '88888888-8888-8888-8888-888888888888', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (1, 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (1, 'bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (1, 'cccccccc-cccc-cccc-cccc-cccccccccccc', 'STUDENT', 'ACTIVE', now(), gen_random_uuid());
### -- 99999999-...는 아무 행도 만들지 않는다 (비재실 케이스용) — 체크인도 하면 안 된다
### -- bbbbbbbb-...(occupier2), cccccccc-...(occupier3)는 참여자 관리 시나리오(9번 이후) 전용이다
###
### -- 체크인 API(AttendanceService.checkIn)가 요구하는 기수 출결 정책. 없으면
### -- ATTENDANCE_POLICY_NOT_FOUND로 체크인 자체가 막힌다.
### INSERT INTO learning_service.cohort_attendance_policies
###   (cohort_id, timezone, scheduled_start_time, scheduled_end_time, updated_by_user_id)
### VALUES
###   (1, 'Asia/Seoul', '09:00', '18:00', gen_random_uuid());
###
### -- 회의실·연구실 직접 INSERT (관리자 API는 status 기본값이 INACTIVE라 활성화 API가 없다)
### INSERT INTO learning_service.spaces
###   (id, name, space_type, capacity, status)
### VALUES
###   (1, '회의실 A', 'MEETING', 4, 'ACTIVE'),
###   (2, '회의실 B', 'MEETING', 4, 'ACTIVE'),
###   (3, '연구실 A', 'LAB', 20, 'ACTIVE'),
###   (4, '회의실 C', 'MEETING', 4, 'INACTIVE'),
###   (5, '회의실 D', 'MEETING', 1, 'ACTIVE');
### -- 회의실 D는 정원 1명이다 — 점유자 혼자로 이미 정원이 차므로 정원 초과(16번) 검증용이다
###
### -- id를 명시해 넣으면 시퀀스가 올라가지 않아 앱이 다음 공간을 만들 때 PK 충돌이 난다.
### SELECT setval(
###   pg_get_serial_sequence('learning_service.cohorts', 'id'),
###   (SELECT MAX(id) FROM learning_service.cohorts));
###
### SELECT setval(
###   pg_get_serial_sequence('learning_service.spaces', 'id'),
###   (SELECT MAX(id) FROM learning_service.spaces));
###
### 확인: 요청이 403 OCCUPANCY_NOT_PRESENT로 실패하면 대개 체크인이 빠진 것이다.
### SELECT id, user_id, status FROM learning_service.cohort_memberships ORDER BY id;
### SELECT id, name, space_type, status FROM learning_service.spaces ORDER BY id;
### SELECT i.id, r.cohort_membership_id, i.state, i.started_at, i.ended_at
###   FROM learning_service.presence_intervals i
###   JOIN learning_service.attendance_records r ON r.id = i.attendance_id
###  ORDER BY i.id;
### -- ended_at이 NULL이고 state가 AWAY가 아닌 행만 재실로 잡힌다.
###
### 주의: 순서 의존이다. 1번부터 차례로 실행할 것. 중간부터 다시 하려면
###       room_occupancies·occupancy_participants를 비우고 1번으로 돌아가는 편이 빠르다.
### =========================================================

@occupier = 88888888-8888-8888-8888-888888888888
@otherOccupier = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
@occupier2 = bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
@occupier3 = cccccccc-cccc-cccc-cccc-cccccccccccc
@absentUser = 99999999-9999-9999-9999-999999999999

### 요청자는 Access JWT의 sub에서만 읽는다 — X-User-Id 헤더는 더 이상 읽지 않는다
### (게이트웨이가 default-filters로 들어오는 X-User-Id를 제거하므로, 헤더에 의존하면
### 정상 경로에서는 오히려 동작하지 않는다). 각 시나리오의 행위자마다 그 sub로 서명한
### 토큰이 하나씩 필요하다.
### 이 토큰들은 로컬 secrets/jwt-private.pem으로 서명했고 secrets/jwt-public.pem으로 검증되니
### .env.local에 JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem이 설정된 상태여야 통과한다.
### exp가 지나면(발급 후 24시간) 401 AUTH_AUTHENTICATION_REQUIRED로 바뀌니 그때는 새로 발급해야 한다.
### 새 토큰 발급: scripts/issue-test-jwt.sh --sub {{occupier}}  (나머지 행위자도 같은 방식)
