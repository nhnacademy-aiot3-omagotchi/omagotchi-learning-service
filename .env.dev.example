# IntelliJ Run Configuration
# Active profiles: dev
# Working directory: learning-service 저장소 루트
#
# 이 파일을 .env.dev로 복사한 뒤 학교의 개발용 DB 접속값으로 바꿉니다.
# 운영 DB 접속값은 개발 환경에 사용하지 않습니다.

SERVER_PORT=8084

# 학교 PostgreSQL의 개발용 DB 또는 schema에 접근하는 계정
DB_URL=jdbc:postgresql://<school-postgresql-host>:<port>/<development-database>
DB_USERNAME=<development-user>
DB_PASSWORD=<development-password>

# 공유 개발 Redis 접속 정보
REDIS_HOST=<development-redis-host>
REDIS_PORT=<development-redis-port>
REDIS_DATABASE=<development-redis-database>
REDIS_USERNAME=<development-redis-user>
REDIS_PASSWORD=<development-redis-password>
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=2s
REDIS_SSL_ENABLED=false

# 공유 DB의 Migration은 담당 절차에서만 실행
FLYWAY_ENABLED=false

# 로컬 인스턴스를 운영 Discovery에 등록하지 않음
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/

# 로컬에서 함께 실행하는 Identity Service 직접 호출
# Identity의 .env.dev에도 같은 Credential 설정 필요
IDENTITY_SERVICE_BASE_URL=http://localhost:8083
IDENTITY_SERVICE_CONNECT_TIMEOUT=1s
IDENTITY_SERVICE_READ_TIMEOUT=2s
LEARNING_IDENTITY_USERNAME=learning-service
LEARNING_IDENTITY_PASSWORD=<replace-me>

# Identity Access JWT 검증용 공개 계약
JWT_ISSUER=https://identity.omagotchi.local
JWT_AUDIENCE=omagotchi-api
JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem

TIMER_MAX_DURATION=PT12H

# Telegram 사용자 연동 링크 설정
# 실제 공개 Bot username. t.me 사용자 연동 링크 생성에 사용
TELEGRAM_BOT_USERNAME=OmagotchiAttending_bot
TELEGRAM_LINK_TOKEN_TTL=PT10M

# 점유 만료 Telegram 알림 활성화 시 token과 chat id 입력
OCCUPANCY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

COMMUNITY_ATTACHMENT_STORAGE_ROOT=data/community-attachments
COMMUNITY_ATTACHMENT_MAX_FILE_SIZE=5MB
COMMUNITY_ATTACHMENT_MAX_COUNT=5
REALTIME_PRESENCE_SESSION_TTL=60s

# RabbitMQ
RABBITMQ_HOST=<broker-host>
RABBITMQ_PORT=<port>
RABBITMQ_USERNAME=<development-user>
RABBITMQ_PASSWORD=<development-password>

# 센서 시계열 조회용 공유 개발 InfluxDB
INFLUXDB_URL=<development-influxdb-url>
INFLUXDB_TOKEN=<development-influxdb-token>
INFLUXDB_ORG_ID=<development-influxdb-org-id>

# 만료 처리와 팀 정합성 스윕 설정
SCHEDULING_ENABLED=true
OCCUPANCY_EXPIRY_FIXED_DELAY=60000
OCCUPANCY_EXPIRY_INITIAL_DELAY=30000
TEAM_SWEEP_FIXED_DELAY=300000
TEAM_SWEEP_INITIAL_DELAY=60000
TEAM_SWEEP_BATCH_SIZE=200

IOT_SECRET=
IOT_BASE_URL=http://localhost:8084/simulator/iot
IOT_SIMULATOR_ENABLED=false