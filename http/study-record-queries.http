# 로컬 DB의 테이블이 모두 비어 있는 상태에서 cohort-memberships.http를 먼저 실행합니다.
# ACTIVE 학생 membership과 cohortId가 준비되었다고 가정하고 위에서 아래 순서대로 한 번 실행합니다.

@baseUrl = http://localhost:8084
@userAccessToken = <USER JWT>
@dailyDate = 2000-01-01
@monthlyMonth = 2000-01


### 일별 조회 확인용 첫 번째 공부 기록 생성 (1시간)
POST {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records
Authorization: Bearer {{userAccessToken}}
X-Command-Id: {{$uuid}}
Content-Type: application/json
Accept: application/json

{
  "date": "{{dailyDate}}",
  "startTime": "09:00",
  "endTime": "10:00"
}

> {%
    client.test("첫 번째 공부 기록 생성", function () {
        client.assert(response.status === 201, "HTTP 상태가 201이어야 합니다.");
        client.assert(response.body.studySeconds === 3600, "공부 시간은 3600초여야 합니다.");
    });
%}

### 일별 조회 확인용 두 번째 공부 기록 생성 (30분)
POST {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records
Authorization: Bearer {{userAccessToken}}
X-Command-Id: {{$uuid}}
Content-Type: application/json
Accept: application/json

{
  "date": "{{dailyDate}}",
  "startTime": "13:30",
  "endTime": "14:00"
}

> {%
    client.test("두 번째 공부 기록 생성", function () {
        client.assert(response.status === 201, "HTTP 상태가 201이어야 합니다.");
        client.assert(response.body.studySeconds === 1800, "공부 시간은 1800초여야 합니다.");
    });
%}

### 월별 조회 확인용 다음 날 공부 기록 생성 (45분)
POST {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records
Authorization: Bearer {{userAccessToken}}
X-Command-Id: {{$uuid}}
Content-Type: application/json
Accept: application/json

{
  "date": "2000-01-02",
  "startTime": "15:00",
  "endTime": "15:45"
}

> {%
    client.test("다음 날 공부 기록 생성", function () {
        client.assert(response.status === 201, "HTTP 상태가 201이어야 합니다.");
        client.assert(response.body.studySeconds === 2700, "공부 시간은 2700초여야 합니다.");
    });
%}

### 일별 공부 기록 조회
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records?date={{dailyDate}}
Authorization: Bearer {{userAccessToken}}
Accept: application/json

> {%
    client.test("일별 공부 기록 조회", function () {
        client.assert(response.status === 200, "HTTP 상태가 200이어야 합니다.");
        client.assert(response.body.aggregationDate === "2000-01-01", "집계일이 일치해야 합니다.");
        client.assert(response.body.totalStudySeconds === 5400, "일별 합계는 5400초여야 합니다.");
        client.assert(response.body.records.length === 2, "공부 기록이 2건이어야 합니다.");
    });
%}

### 월별 공부 시간 조회
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-time-summaries?month={{monthlyMonth}}
Authorization: Bearer {{userAccessToken}}
Accept: application/json

> {%
    client.test("월별 공부 시간 조회", function () {
        client.assert(response.status === 200, "HTTP 상태가 200이어야 합니다.");
        client.assert(response.body.aggregationMonth === "2000-01", "집계월이 일치해야 합니다.");
        client.assert(response.body.totalStudySeconds === 8100, "월별 합계는 8100초여야 합니다.");
        client.assert(response.body.dailyTotals.length === 31, "1월의 모든 날짜가 반환되어야 합니다.");
        client.assert(response.body.dailyTotals[0].studySeconds === 5400, "1일 합계는 5400초여야 합니다.");
        client.assert(response.body.dailyTotals[1].studySeconds === 2700, "2일 합계는 2700초여야 합니다.");
        client.assert(response.body.dailyTotals[2].studySeconds === 0, "기록이 없는 3일은 0초여야 합니다.");
    });
%}
