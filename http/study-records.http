# cohort-memberships.http를 먼저 실행하여 ACTIVE membership과 cohortId를 준비합니다.
# 아래 요청은 study_records를 실제로 생성·수정·삭제합니다.

@baseUrl = http://localhost:8084
@userId = 00000000-0000-0000-0000-000000000003
@studyDate = 2000-01-01

### 애플리케이션 및 DB 연결 상태 확인
GET {{baseUrl}}/actuator/health
Accept: application/json

### 공부 기록 생성
# @name createStudyRecord
POST {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records
X-User-Id: {{userId}}
X-Command-Id: {{$uuid}}
Content-Type: application/json
Accept: application/json

{
  "date": "{{studyDate}}",
  "startTime": "09:00",
  "endTime": "10:00"
}

> {%
    if (response.status === 201) {
        client.global.set("studyRecordId", response.body.id);
        client.global.set("studyRecordVersion", response.body.version);
    }
%}

### 생성한 공부 기록 조회
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records/{{studyRecordId}}
X-User-Id: {{userId}}
Accept: application/json

### 생성한 공부 기록 수정
# @name updateStudyRecord
PUT {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records/{{studyRecordId}}
X-User-Id: {{userId}}
X-Command-Id: {{$uuid}}
Content-Type: application/json
Accept: application/json

{
  "date": "{{studyDate}}",
  "startTime": "10:00",
  "endTime": "11:00",
  "expectedVersion": {{studyRecordVersion}}
}

> {%
    if (response.status === 200) {
        client.global.set("studyRecordVersion", response.body.version);
    }
%}

### 수정한 공부 기록 삭제
DELETE {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records/{{studyRecordId}}
X-User-Id: {{userId}}
X-Command-Id: {{$uuid}}
If-Match: {{studyRecordVersion}}

### 삭제된 공부 기록 조회
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/study-records/{{studyRecordId}}
X-User-Id: {{userId}}
Accept: application/json
