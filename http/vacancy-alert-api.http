@baseUrl = http://localhost:8084

### 공실 알림 API (MR-02, MR-15, MR-17, MR-34)
### 신청·중복 신청 차단·본인 방 거부·빈 방 거부·조회·취소까지 확인한다.
### 발송(MR-03)은 아직 구현되어 있지 않다 — 여기서는 "취소까지" 되는지만 본다.
### occupancy-api.http와 같은 DB에서 실행해도 되도록 cohortId=2, spaceId=10/11을 쓴다
### (occupancy-api.http는 cohortId=1, spaceId=1~5를 쓴다).

### =========================================================
### 사전 준비 (psql로 직접 INSERT)
###
### INSERT INTO learning_service.cohorts
###   (id, name, start_date, end_date, status, created_by_user_id)
### VALUES
###   (2, '공실 알림 테스트 기수', '2026-01-01', '2026-12-31', 'ACTIVE', gen_random_uuid());
###
### -- occupier: 방을 점유할 사람. waiter: 알림을 신청할 사람. stranger: 아무 신청도
### -- 없지만 같은 기수 소속이라 "남의 신청 취소 시도"가 403이 아니라 404로 막히는 걸 보여준다.
### INSERT INTO learning_service.cohort_memberships
###   (cohort_id, user_id, role, status, processed_at, processed_by_user_id)
### VALUES
###   (2, '10101010-1010-1010-1010-101010101010', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (2, '20202020-2020-2020-2020-202020202020', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (2, '30303030-3030-3030-3030-303030303030', 'STUDENT', 'ACTIVE', now(), gen_random_uuid());
###
### -- occupier가 방을 점유하려면 재실이 필요하고, 재실 체크인은 출결 정책을 요구한다.
### -- waiter·stranger는 신청/취소에 재실이 필요 없으므로 체크인하지 않는다.
### INSERT INTO learning_service.cohort_attendance_policies
###   (cohort_id, timezone, scheduled_start_time, scheduled_end_time, updated_by_user_id)
### VALUES
###   (2, 'Asia/Seoul', '09:00', '18:00', gen_random_uuid());
###
### -- spaceId=10: occupier가 점유해 알림 신청 대상이 될 회의실
### -- spaceId=11: 아무도 점유하지 않는 채로 남겨 "빈 방 신청(400)" 케이스에 쓴다
### INSERT INTO learning_service.spaces
###   (id, name, space_type, capacity, status)
### VALUES
###   (10, '알림 테스트 회의실 A', 'MEETING', 4, 'ACTIVE'),
###   (11, '알림 테스트 회의실 B(항상 빈 방)', 'MEETING', 4, 'ACTIVE');
###
### SELECT setval(
###   pg_get_serial_sequence('learning_service.cohorts', 'id'),
###   (SELECT MAX(id) FROM learning_service.cohorts));
###
### SELECT setval(
###   pg_get_serial_sequence('learning_service.spaces', 'id'),
###   (SELECT MAX(id) FROM learning_service.spaces));
###
### 확인:
### 주의: 순서 의존이다. 1번부터 차례로 실행할 것.
### SELECT id, user_id, status FROM learning_service.cohort_memberships WHERE cohort_id = 2 ORDER BY id;
### SELECT id, name, status FROM learning_service.spaces WHERE id IN (10, 11) ORDER BY id;
###
### 토큰은 로컬 secrets/jwt-private.pem으로 서명했고 secrets/jwt-public.pem으로 검증되니
### .env.local에 JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem이 설정돼 있어야 통과한다.
### exp가 지나면(발급 후 24시간) 401 AUTH_AUTHENTICATION_REQUIRED로 바뀌니 새로 발급해야 한다:
###   scripts/issue-test-jwt.sh --sub {{occupier}}  (waiter·stranger도 같은 방식)
### =========================================================

