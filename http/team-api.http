@baseUrl = http://localhost:8084/api/v1

### cohort 1에만 ACTIVE 멤버십. 1번에서 팀을 만들고 이후 마스터 역할을 계속 맡는다.
@master = 11111111-1111-1111-1111-111111111111
### 어떤 기수에도 멤버십이 없는 계정.
@outsider = 22222222-2222-2222-2222-222222222222
### cohort 1 소속. 실패 케이스에만 쓰여서 21번까지 팀에 속하지 않는다.
@member = 33333333-3333-3333-3333-333333333333
### cohort 2 소속. GR-22(기수 정합) 위반 케이스용.
@otherCohort = 44444444-4444-4444-4444-444444444444
### cohort 1·2에 모두 ACTIVE 멤버십. 다기수 담당 매니저.
@multiCohort = 55555555-5555-5555-5555-555555555555
### cohort 1 소속. 성공 케이스에서 한 번씩 소비되는 계정.
@spare1 = 66666666-6666-6666-6666-666666666666
@spare2 = 77777777-7777-7777-7777-777777777777

### =========================================================
### 사전 준비 (psql로 직접 INSERT)
###
### 인증이 아직 연동되지 않아 X-User-Id 헤더로 요청자를 식별한다.
### 따라서 헤더에 넣는 계정이 ACTIVE cohort_membership을 실제로 가지고 있어야 한다.
###
### INSERT INTO learning_service.cohorts
###   (id, name, start_date, end_date, status, created_by_user_id)
### VALUES
###   (1, '테스트 기수 1', '2026-01-01', '2026-12-31', 'ACTIVE', gen_random_uuid()),
###   (2, '테스트 기수 2', '2026-01-01', '2026-12-31', 'ACTIVE', gen_random_uuid());
###
### INSERT INTO learning_service.cohort_memberships
###   (cohort_id, user_id, role, status, processed_at, processed_by_user_id)
### VALUES
###   (1, '11111111-1111-1111-1111-111111111111', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (1, '33333333-3333-3333-3333-333333333333', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (2, '44444444-4444-4444-4444-444444444444', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (1, '55555555-5555-5555-5555-555555555555', 'MANAGER', 'ACTIVE', now(), gen_random_uuid()),
###   (2, '55555555-5555-5555-5555-555555555555', 'MANAGER', 'ACTIVE', now(), gen_random_uuid()),
###   (1, '66666666-6666-6666-6666-666666666666', 'STUDENT', 'ACTIVE', now(), gen_random_uuid()),
###   (1, '77777777-7777-7777-7777-777777777777', 'STUDENT', 'ACTIVE', now(), gen_random_uuid());
###
### -- cohorts.id는 GENERATED BY DEFAULT AS IDENTITY다. 위처럼 id를 명시해 넣으면
### -- 시퀀스가 올라가지 않아, 나중에 앱이 기수를 만들 때 id 1을 다시 쓰려다 PK 충돌이 난다.
### SELECT setval(
###   pg_get_serial_sequence('learning_service.cohorts', 'id'),
###   (SELECT MAX(id) FROM learning_service.cohorts)
### );
###
### 22222222-... 는 아무 행도 만들지 않는다 (멤버십 없음 케이스).
###
### 확인: 요청이 403 TEAM_COHORT_ACCESS_DENIED로 실패하면 대개 이 준비가 덜 된 것이다.
### SELECT id, name, status FROM learning_service.cohorts ORDER BY id;
### SELECT cohort_id, user_id, role, status FROM learning_service.cohort_memberships ORDER BY cohort_id, id;
### 기수 id가 1·2가 아니면 아래 요청들의 cohortId를 실제 값으로 바꿔야 한다.
###
### 주의: 순서 의존이다. 1번부터 차례로 실행할 것. 중간부터 다시 하려면
###       teams·team_members를 비우고 1번으로 돌아가는 편이 빠르다.
###
### 재현 불가: GR-11(탈퇴 계정 추가 차단)은 StubAccountReader가 항상 ACTIVE를 돌려주므로
###           HTTP로 확인할 수 없다. Identity Service 연동 후에 추가한다.
###           마스터 위임·팀 해체 API는 아직 없다 (이슈 #8).
### =========================================================


### =========================================================
### 1. 팀 생성 성공
### 기대: 201 Created. 응답 teamId를 이후 요청에 쓴다 (아래는 1이라고 가정)
###       teams 1행 + 생성자의 MASTER team_members 1행이 한 트랜잭션으로 생긴다
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{master}}

{
  "cohortId": 1,
  "name": "테스트팀"
}


### =========================================================
### 2. X-User-Id 헤더 누락
### 기대: 400 Bad Request
### 주의: MissingRequestHeaderException 핸들러가 GlobalExceptionHandler에 없어서
###       공통 오류 형식({status, code, message, path})이 아니라 Spring 기본 응답이 온다.
###       global 파트에 마지막 Exception 핸들러가 추가되면 형식이 통일된다.
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json

{
  "cohortId": 1,
  "name": "헤더누락팀"
}


### =========================================================
### 3. 같은 기수에 중복된 팀 이름
### 기대: 409 Conflict / TEAM_DUPLICATE_NAME
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{member}}

{
  "cohortId": 1,
  "name": "테스트팀"
}


### =========================================================
### 4. 대소문자·앞뒤 공백만 다른 이름도 중복이다 (GR-21)
### 유니크가 LOWER(BTRIM(name)) 기준이므로 정규화 후 같으면 막힌다
### 기대: 409 Conflict / TEAM_DUPLICATE_NAME
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{member}}

{
  "cohortId": 1,
  "name": "   테스트팀   "
}


### =========================================================
### 5. 다른 기수에는 같은 이름을 쓸 수 있다 (GR-21)
### 기대: 201 Created
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{otherCohort}}

{
  "cohortId": 2,
  "name": "테스트팀"
}


### =========================================================
### 6. 이미 그 기수의 팀에 소속된 계정이 다른 이름으로 재요청
### 기대: 409 Conflict / TEAM_ALREADY_IN_TEAM
### GR-18은 기수 내 제약이므로 다른 기수라면 허용된다 (15번 참고)
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{master}}

{
  "cohortId": 1,
  "name": "두번째팀"
}


### =========================================================
### 7. 담당하지 않는 기수를 지정 (RM-28)
### 기대: 403 Forbidden / TEAM_COHORT_ACCESS_DENIED
### 클라이언트가 보낸 cohortId를 서버가 신뢰하지 않는다는 것을 확인한다
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{member}}

{
  "cohortId": 999,
  "name": "존재하지않는기수팀"
}


### =========================================================
### 8. 빈 팀 이름
### 기대: 400 Bad Request / TEAM_INVALID_NAME
###
### Bean Validation이 아니라 Team.isValidName() 판정 결과다. @NotBlank·@Size를 떼고
### 규칙을 도메인 한 곳에 모았기 때문에 code가 COMMON_INVALID_REQUEST가 아니라
### TEAM_INVALID_NAME으로 온다 — 뒤바뀌면 검증 위치가 되돌아간 것이다.
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{member}}

{
  "cohortId": 1,
  "name": ""
}


### =========================================================
### 9. 공백만 있는 팀 이름
### 기대: 400 Bad Request / TEAM_INVALID_NAME
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{member}}

{
  "cohortId": 1,
  "name": "     "
}


### =========================================================
### 10. 정규화 후 31자
### 기대: 400 Bad Request / TEAM_INVALID_NAME
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{member}}

{
  "cohortId": 1,
  "name": "1234567890123456789012345678901"
}


### =========================================================
### 11. 정규화 후 정확히 30자 + 앞뒤 공백
### 기대: 201 Created
###
### 원문은 32자지만 trim 후 30자라 GR-21상 유효하다. 과거 @Size(max = 30)이 trim 전
### 길이를 봐서 이 케이스가 400으로 잘렸다 — 회귀 확인용이다.
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{spare1}}

{
  "cohortId": 1,
  "name": " 123456789012345678901234567890 "
}


### =========================================================
### 12. cohortId 생략 — 활성 멤버십이 아예 없는 계정
### 기대: 403 Forbidden / TEAM_COHORT_ACCESS_DENIED
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{outsider}}

{
  "name": "기수생략팀"
}


### =========================================================
### 13. cohortId 생략 — 활성 기수가 하나뿐인 계정 (RM-28)
### 기대: 201 Created
### 선택할 기수가 하나면 서버가 결정하므로 UI에서 선택 단계를 생략할 수 있다
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{spare2}}

{
  "name": "기수생략팀"
}


### =========================================================
### 14. cohortId 생략 — 활성 기수가 둘인 계정
### 기대: 400 Bad Request / TEAM_COHORT_REQUIRED
### 매니저·멘토는 여러 기수를 담당할 수 있어 서버가 기수를 단정할 수 없다
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{multiCohort}}

{
  "name": "기수생략팀"
}


### =========================================================
### 15. 다기수 담당자가 기수별로 팀을 하나씩 만든다
### 기대: 두 요청 모두 201 Created
### GR-18("기수당 1인 1팀")이 계정이 아니라 멤버십 단위임을 확인한다
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{multiCohort}}

{
  "cohortId": 1,
  "name": "1기팀"
}

###
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{multiCohort}}

{
  "cohortId": 2,
  "name": "2기팀"
}


### =========================================================
### 16. 팀 상세 조회 (소속자)
### 기대: 200 OK. members에 본인이 MASTER로 있고 마스터가 목록 앞에 온다.
###       displayName은 StubAccountReader가 만든 "사용자-xxxxxxxx" 형태다.
###       응답에 user_id·cohort_membership_id가 없어야 한다 (GR-15)
### =========================================================
GET {{baseUrl}}/teams/1
X-User-Id: {{master}}


### =========================================================
### 17. 내 팀 목록
### 기대: 200 OK. 소속이 없으면 404가 아니라 빈 배열
### =========================================================
GET {{baseUrl}}/teams/me
X-User-Id: {{master}}


### =========================================================
### 18. 비소속자 조회 — 그 기수에 멤버십 자체가 없는 계정
### 기대: 403 Forbidden / TEAM_COHORT_ACCESS_DENIED
### TeamAccessSupport.requireActiveMembership에서 차단된다.
### 팀원 여부를 보기 전에 기수 소속에서 먼저 걸리므로 TEAM_NOT_A_MEMBER가 아니다
### =========================================================
GET {{baseUrl}}/teams/1
X-User-Id: {{outsider}}


### =========================================================
### 19. 비소속자 조회 — 같은 기수지만 이 팀 소속은 아닌 계정
### 기대: 403 Forbidden / TEAM_NOT_A_MEMBER
### TeamAccessSupport.requireMembership에서 차단된다.
### 404가 아니라 403인 것이 의도다 — 팀 존재 여부 자체를 알려주지 않는다
### =========================================================
GET {{baseUrl}}/teams/1
X-User-Id: {{member}}


### =========================================================
### 20. 존재하지 않는 팀 조회
### 기대: 404 Not Found / TEAM_NOT_FOUND
### =========================================================
GET {{baseUrl}}/teams/999999
X-User-Id: {{master}}


### =========================================================
### 21. 팀원 추가 (마스터가 같은 기수의 사람을 추가)
### 기대: 201 Created, 응답 본문 없음
### 3·4·7~10번이 모두 실패했으므로 {{member}}는 아직 팀에 속하지 않은 상태다
### =========================================================
POST {{baseUrl}}/teams/1/members
Content-Type: application/json
X-User-Id: {{master}}

{
  "targetUserId": "{{member}}"
}


### =========================================================
### 22. 타 기수 사용자를 팀원으로 추가 (GR-22)
### 기대: 400 Bad Request / TEAM_TARGET_NOT_IN_COHORT
###
### ERD v3에서 team_members.cohort_id와 복합 FK가 사라져 DB가 이걸 막지 못한다.
### 애플리케이션 검증이 유일한 방어선이므로, 통과하면 데이터가 그대로 오염된다.
### =========================================================
POST {{baseUrl}}/teams/1/members
Content-Type: application/json
X-User-Id: {{master}}

{
  "targetUserId": "{{otherCohort}}"
}


### =========================================================
### 23. 비마스터가 팀원 추가 시도
### 기대: 403 Forbidden / TEAM_MASTER_REQUIRED
### 21번으로 MEMBER가 된 계정으로 요청한다. 대상 검증보다 권한 검증이 먼저 걸린다
### =========================================================
POST {{baseUrl}}/teams/1/members
Content-Type: application/json
X-User-Id: {{member}}

{
  "targetUserId": "{{spare1}}"
}


### =========================================================
### 24. 정원 초과 (GR-17)
### 기대: 409 Conflict / TEAM_CAPACITY_EXCEEDED
###
### 요청을 여섯 번 반복하는 대신 SQL로 팀을 8명까지 채운다.
### 지금 팀 1은 마스터 + 21번에서 추가된 1명 = 2명이다.
###
### INSERT INTO learning_service.cohort_memberships
###   (cohort_id, user_id, role, status, processed_at, processed_by_user_id)
### SELECT 1, gen_random_uuid(), 'STUDENT', 'ACTIVE', now(), gen_random_uuid()
###   FROM generate_series(1, 7);
###
### INSERT INTO learning_service.team_members (team_id, cohort_membership_id, role)
### SELECT 1, cm.id, 'MEMBER'
###   FROM learning_service.cohort_memberships cm
###  WHERE cm.cohort_id = 1
###    AND cm.id NOT IN (SELECT cohort_membership_id FROM learning_service.team_members)
###  LIMIT 6;
###
### 남은 한 명의 user_id를 조회해 아래 targetUserId에 넣는다:
### SELECT cm.user_id FROM learning_service.cohort_memberships cm
###  WHERE cm.cohort_id = 1
###    AND cm.id NOT IN (SELECT cohort_membership_id FROM learning_service.team_members);
### =========================================================
POST {{baseUrl}}/teams/1/members
Content-Type: application/json
X-User-Id: {{master}}

{
  "targetUserId": "6aad2d10-3978-437d-baf5-b38ab8e0323d"
}


### =========================================================
### 25. 팀원이 남아있는 상태에서 마스터가 탈퇴 시도
### 기대: 409 Conflict / TEAM_DELEGATION_REQUIRED
### 위임 API가 아직 없어서(이슈 #8) 지금은 이 상태에서 마스터가 나갈 방법이 없다
### =========================================================
POST {{baseUrl}}/teams/1/leave
X-User-Id: {{master}}


### =========================================================
### 26. 팀원 제외 (마스터가 일반 팀원을 제외)
### 기대: 204 No Content
### memberId는 계정 id도 멤버십 id도 아닌 team_members.id다.
### 16번 응답의 members[].memberId를 그대로 쓰면 된다
### =========================================================
DELETE {{baseUrl}}/teams/1/members/13
X-User-Id: {{master}}


### =========================================================
### 27. 마스터 본인을 제외 시도
### 기대: 400 Bad Request / TEAM_MASTER_CANNOT_BE_KICKED
### MASTER 0명 상태가 되면 아무도 그 팀을 관리할 수 없다
### =========================================================
DELETE {{baseUrl}}/teams/1/members/1
X-User-Id: {{master}}


### =========================================================
### 28. 다른 팀의 memberId를 지정해 제외 시도
### 기대: 404 Not Found / TEAM_MEMBER_NOT_FOUND
###
### memberId가 팀을 가리지 않으므로 팀 소속 재확인이 반드시 필요하다.
### 아래 77은 자리표시자다. 5번에서 만든 cohort 2 팀의 팀원 id로 바꿔 넣을 것:
### SELECT id, team_id FROM learning_service.team_members WHERE team_id <> 1;
### =========================================================
DELETE {{baseUrl}}/teams/1/members/77
X-User-Id: {{master}}


### =========================================================
### 29. 존재하지 않는 팀원 제외
### 기대: 404 Not Found / TEAM_MEMBER_NOT_FOUND
### =========================================================
DELETE {{baseUrl}}/teams/1/members/999999
X-User-Id: {{master}}


### =========================================================
### 30. 혼자 남은 마스터가 탈퇴 (GR-13)
### 사전: 26번을 반복해 다른 팀원을 모두 제외한 뒤 실행
### 기대: 204 No Content.
###       teams.deleted_at이 채워지고(행은 보존) team_members 행은 물리 삭제된다
### =========================================================
POST {{baseUrl}}/teams/1/leave
X-User-Id: {{master}}


### =========================================================
### 31. 해체된 팀 조회
### 기대: 404 Not Found / TEAM_NOT_FOUND
### 행은 남아 있지만 없는 것으로 취급된다
### =========================================================
GET {{baseUrl}}/teams/1
X-User-Id: {{master}}


### =========================================================
### 32. 해체된 팀과 같은 이름으로 재생성
### 기대: 201 Created
### 이름 유니크가 활성 팀 한정(WHERE deleted_at IS NULL)이고,
### 해체 시 팀원 행을 물리 삭제했기 때문에 1인 1팀 유니크도 함께 풀린다
### =========================================================
POST {{baseUrl}}/teams
Content-Type: application/json
X-User-Id: {{master}}

{
  "cohortId": 1,
  "name": "테스트팀"
}