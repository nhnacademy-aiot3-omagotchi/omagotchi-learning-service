# IntelliJ Run Configuration
# Active profiles: local
# Working directory: learning-service 저장소 루트

SERVER_PORT=8084

# 로컬 PostgreSQL 접속 정보
DB_URL=jdbc:postgresql://localhost:5432/learning_service
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis Presence 저장소. 인증 없는 로컬 Redis는 username/password를 비워 둡니다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=2s
REDIS_SSL_ENABLED=false

# Discovery Service를 함께 실행할 때 true로 변경
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/

# Identity가 로컬에서 생성한 Access JWT key pair의 공개 계약
JWT_ISSUER=https://identity.omagotchi.local
JWT_AUDIENCE=omagotchi-api
JWT_PUBLIC_KEY_LOCATION=file:../identity-service/secrets/jwt-public.pem

# 타이머 만료 최대 시간
TIMER_MAX_DURATION=PT12H

# 공부 시간 예측 AI 서비스 Base URL
PREDICTION_SERVICE_BASE_URL=http://localhost:8085

# Telegram 사용자 연동 링크 설정
# 실제 공개 Bot username. t.me 사용자 연동 링크 생성에 사용
TELEGRAM_BOT_USERNAME=OmagotchiAttending_bot
TELEGRAM_LINK_TOKEN_TTL=PT10M

# 점유 만료 Telegram 알림 활성화 시 token과 chat id 입력
OCCUPANCY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 커뮤니티 첨부파일과 실시간 Presence 설정
COMMUNITY_ATTACHMENT_STORAGE_ROOT=data/community-attachments
COMMUNITY_ATTACHMENT_MAX_FILE_SIZE=5MB
COMMUNITY_ATTACHMENT_MAX_COUNT=5
REALTIME_PRESENCE_SESSION_TTL=60s

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# 센서 시계열 조회용 로컬 InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=local-token
INFLUXDB_ORG_ID=local-org

# 만료 처리와 팀 정합성 스윕 설정
SCHEDULING_ENABLED=true
OCCUPANCY_EXPIRY_FIXED_DELAY=60000
OCCUPANCY_EXPIRY_INITIAL_DELAY=30000
TEAM_SWEEP_FIXED_DELAY=300000
TEAM_SWEEP_INITIAL_DELAY=60000
TEAM_SWEEP_BATCH_SIZE=200

IOT_SECRET=
IOT_BASE_URL=http://localhost:8084/simulator/iot
IOT_SIMULATOR_ENABLED=false